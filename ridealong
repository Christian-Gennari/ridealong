#!/usr/bin/env bash
# Runs Ridealong in Docker: a real, logged-in Brave for AI agents.
set -euo pipefail

REPO=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# An instance name keeps a second install (a test copy, scripts/smoke) apart from
# the real one: own compose project, container, image, config and profile. The
# default name is the one every existing install already uses.
NAME=${RIDEALONG_NAME:-ridealong}
if [ "${1:-}" = --name ]; then
  [ $# -ge 2 ] || { echo "--name needs a value" >&2; exit 2; }
  NAME=$2; shift 2
fi
[[ $NAME =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "Bad name: $NAME (use lowercase letters, digits, - and _)" >&2; exit 1; }
export RIDEALONG_NAME=$NAME
if [ "$NAME" = ridealong ]; then SUFFIX=; else SUFFIX=-$NAME; fi
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/ridealong$SUFFIX
CONFIG=$CONFIG_DIR/config.env
LINK=$HOME/.local/bin/ridealong
CONTAINER=$NAME

usage() {
  cat <<'HELP'
Usage: ridealong [--name NAME] <command>

  --name NAME Manage a separate instance with its own container and config
              (default: ridealong, or $RIDEALONG_NAME)

  up        Start Ridealong, downloading it the first time
              --network auto|tailscale|ssh|lan   How you reach the viewer
              --host-network                     Let agents open localhost on this server
              --port N                           Viewer port (default 6086)
              --https-port N                     Tailscale port (default 6087)
              --resolution WxH                   Screen size (default 1920x1080)
              --allow-host NAME                  Accept this address, for your own proxy
              --notify URL                       Push here when it's your turn
              --build                            Build from this checkout instead of downloading
              --profile DIR                      Brave profile (default ~/.ridealong-browser)
              --files DIR                        Folder shared with agents (default ~/ridealong-files)
  down      Stop it
  restart   Restart it
  status    Show whether it's healthy and where to find it
  logs      Follow the logs
  update    Get the latest version, including Brave, and restart
  connect   Connect the MCP clients installed here
  migrate   Replace an older install that ran directly on this server
  uninstall Remove the container and agent config, keeping your profile and files
HELP
}

die() { echo "$1" >&2; exit 1; }

have_docker() {
  command -v docker >/dev/null || die "Ridealong needs Docker: https://docs.docker.com/engine/install/"
  docker compose version >/dev/null 2>&1 || die "Ridealong needs Docker Compose: https://docs.docker.com/compose/install/"
  docker info >/dev/null 2>&1 || die "Can't reach Docker. Is it running, and is $(id -un) in the docker group?"
}

load() {
  # shellcheck disable=SC1090
  if [ -f "$CONFIG" ]; then . "$CONFIG"; fi
}

compose() {
  local files=(-f "$REPO/compose.yaml")
  [ "${RIDEALONG_HOST_NETWORK:-0}" = 1 ] && files+=(-f "$REPO/compose.host.yaml")
  docker compose -p "$NAME" --project-directory "$REPO" --env-file "$CONFIG" "${files[@]}" "$@"
}

running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = true ]
}

timezone() {
  if command -v timedatectl >/dev/null; then timedatectl show -p Timezone --value 2>/dev/null && return; fi
  cat /etc/timezone 2>/dev/null || echo UTC
}

tailnet_host() {
  command -v tailscale >/dev/null || return 0
  tailscale status --json 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(d["Self"]["DNSName"].rstrip(".") if d.get("BackendState") == "Running" else "")' 2>/dev/null || true
}

write_config() {
  mkdir -p "$CONFIG_DIR"
  (umask 077; cat > "$CONFIG" <<CONF
RIDEALONG_NETWORK=$NETWORK
RIDEALONG_HOST_NETWORK=$HOST_NETWORK
RIDEALONG_URL="$URL"
RIDEALONG_TOKEN=$TOKEN
RIDEALONG_BIND=$BIND
RIDEALONG_PORT=$PORT
RIDEALONG_HTTPS_PORT=$HTTPS_PORT
RIDEALONG_RESOLUTION=$RESOLUTION
RIDEALONG_ALLOWED_HOSTS=$ALLOWED_HOSTS
RIDEALONG_NOTIFY_URL="$NOTIFY_URL"
RIDEALONG_PROFILE=$PROFILE
RIDEALONG_FILES=$FILES
RIDEALONG_IDLE_HIDE_MIN=${RIDEALONG_IDLE_HIDE_MIN:-15}
RIDEALONG_IDLE_RELEASE_MIN=${RIDEALONG_IDLE_RELEASE_MIN:-120}
RIDEALONG_NAME=$NAME
RIDEALONG_IMAGE=$IMAGE
RIDEALONG_UID=$(id -u)
RIDEALONG_GID=$(id -g)
RIDEALONG_TZ=$(timezone)
RIDEALONG_VERSION=$(git -C "$REPO" describe --always --dirty 2>/dev/null || echo dev)
RIDEALONG_BUILT=${RIDEALONG_BUILT:-$(date +%s)}
RIDEALONG_REFRESH=${RIDEALONG_REFRESH:-$(date +%F)}
CONF
  )
}

wait_healthy() {
  echo "Waiting for Brave..."
  for _ in $(seq 60); do
    [ "$(docker inspect -f '{{.State.Health.Status}}' "$CONTAINER" 2>/dev/null)" = healthy ] && return 0
    docker exec "$CONTAINER" curl -fsS -m 2 http://127.0.0.1:9222/json/version >/dev/null 2>&1 && return 0
    sleep 1
  done
  die "Ridealong didn't come up. See: ridealong logs"
}

serve_tailscale() {
  [ "$NETWORK" = tailscale ] || return 0
  tailscale serve status 2>/dev/null | grep -q ":$HTTPS_PORT" && return 0
  if ! timeout 20 tailscale serve --bg --https="$HTTPS_PORT" "http://127.0.0.1:$PORT" >/dev/null 2>&1; then
    echo "Couldn't set up Tailscale's HTTPS link. Turn on HTTPS at https://login.tailscale.com/admin/dns, then run:"
    echo "  sudo tailscale serve --bg --https=$HTTPS_PORT http://127.0.0.1:$PORT"
  fi
}

cmd_up() {
  load
  NETWORK=${RIDEALONG_NETWORK:-auto}
  HOST_NETWORK=${RIDEALONG_HOST_NETWORK:-0}
  PORT=${RIDEALONG_PORT:-6086}
  HTTPS_PORT=${RIDEALONG_HTTPS_PORT:-6087}
  RESOLUTION=${RIDEALONG_RESOLUTION:-1920x1080}
  ALLOWED_HOSTS=${RIDEALONG_ALLOWED_HOSTS:-}
  NOTIFY_URL=${RIDEALONG_NOTIFY_URL:-}
  PROFILE=${RIDEALONG_PROFILE:-$HOME/.ridealong-browser$SUFFIX}
  FILES=${RIDEALONG_FILES:-$HOME/ridealong-files$SUFFIX}
  TOKEN=${RIDEALONG_TOKEN:-}
  local build=no
  # A named instance gets its own image tag, so building it never retags the
  # image the real install runs, and it never pulls.
  IMAGE=${RIDEALONG_IMAGE:-}
  if [ -n "$SUFFIX" ]; then IMAGE=ridealong-dev:$NAME; build=yes; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --network) NETWORK=$2; shift 2 ;;
      --host-network) HOST_NETWORK=1; shift ;;
      --port) PORT=$2; shift 2 ;;
      --https-port) HTTPS_PORT=$2; shift 2 ;;
      --resolution) RESOLUTION=$2; shift 2 ;;
      --allow-host) ALLOWED_HOSTS=${ALLOWED_HOSTS:+$ALLOWED_HOSTS,}$2; shift 2 ;;
      --notify) NOTIFY_URL=$2; shift 2 ;;
      --build) build=yes; shift ;;
      --profile) PROFILE=$(realpath -m "$2"); shift 2 ;;
      --files) FILES=$(realpath -m "$2"); shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  have_docker

  # The viewer stays on loopback unless --network lan asks otherwise; Tailscale
  # or an SSH tunnel reaches it there.
  BIND=127.0.0.1
  local tailnet=
  if [ "$NETWORK" = auto ] || [ "$NETWORK" = tailscale ]; then
    tailnet=$(tailnet_host)
    [ "$NETWORK" = tailscale ] && [ -z "$tailnet" ] && die "Tailscale isn't connected. Run 'tailscale up', or use --network ssh."
    [ -n "$tailnet" ] && NETWORK=tailscale || NETWORK=ssh
  fi
  case "$NETWORK" in
    tailscale) URL="https://$tailnet:$HTTPS_PORT/" ;;
    ssh) URL="http://127.0.0.1:$PORT/" ;;
    lan)
      [ "$HOST_NETWORK" = 1 ] && die "--network lan doesn't work with --host-network."
      BIND=0.0.0.0
      TOKEN=${TOKEN:-$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')}
      URL="http://$(hostname -I | awk '{print $1}'):$PORT/?token=$TOKEN"
      ;;
    *) die "Unknown network: $NETWORK (use tailscale, ssh or lan)" ;;
  esac
  [ "$NETWORK" = lan ] || TOKEN=

  # Created here so they belong to you, not to Docker.
  install -d -m 700 "$PROFILE" "$FILES"
  write_config
  load
  # A published image is much quicker than building one. Build if there isn't one.
  if [ "$build" = yes ] || ! compose pull --quiet 2>/dev/null; then
    compose up -d --build
  else
    compose up -d
  fi
  wait_healthy
  serve_tailscale

  # Only the real install owns the command link and the agents' MCP entries.
  if [ -z "$SUFFIX" ] && [ ! -e "$LINK" ]; then
    mkdir -p "$(dirname "$LINK")"
    ln -s "$REPO/ridealong" "$LINK"
    cmd_connect
  fi

  echo
  echo "Ridealong is ready."
  echo
  echo "  Viewer:  $URL"
  case "$NETWORK" in
    ssh)
      echo "  This viewer is private to this server. From your computer run:"
      echo "    ssh -L $PORT:127.0.0.1:$PORT $(id -un)@$(hostname)"
      echo "  Then open the link above. Tailscale gives you an always-on link from any device."
      ;;
    lan) echo "  Anyone on this network with that link controls a logged-in browser. Keep it secret." ;;
  esac
  echo
  echo "  Next: in the viewer choose Control, sign into your accounts in Brave, then go back to Auto."
}

cmd_status() {
  load
  have_docker
  if ! running; then
    echo "Ridealong is stopped. Start it with: ridealong up"
    return
  fi
  local health
  health=$(docker exec "$CONTAINER" curl -fsS -m 4 http://127.0.0.1:"$(internal_port)"/api/health 2>/dev/null || echo "")
  echo "Container:  $(docker inspect -f '{{.State.Status}}, {{.State.Health.Status}}' "$CONTAINER")"
  echo "Viewer:     ${RIDEALONG_URL:-unknown}"
  echo "Brave:      $(docker exec "$CONTAINER" curl -fsS -m 4 http://127.0.0.1:9222/json/version 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["Browser"])' 2>/dev/null || echo NOT ANSWERING)"
  echo "Ridealong:  ${health:-viewer NOT ANSWERING}"
}

internal_port() {
  if [ "${RIDEALONG_HOST_NETWORK:-0}" = 1 ]; then echo "${RIDEALONG_PORT:-6086}"; else echo 6086; fi
}

cmd_update() {
  load
  have_docker
  git -C "$REPO" pull --ff-only
  RIDEALONG_REFRESH=$(date +%s)
  RIDEALONG_BUILT=$(date +%s)
  export RIDEALONG_REFRESH RIDEALONG_BUILT
  cmd_up
}

# Stdin and stdout belong to the MCP client here, so anything else goes to stderr.
cmd_mcp() {
  load
  have_docker >&2
  running || cmd_up >&2
  exec docker exec -i ${RIDEALONG_ELICITATION:+-e RIDEALONG_ELICITATION} "$CONTAINER" ridealong-mcp "$@"
}

cmd_connect() {
  [ -z "$SUFFIX" ] || die "Agents connect to the default instance only. For $NAME, run: RIDEALONG_NAME=$NAME ridealong mcp"
  load
  RIDEALONG_URL=${RIDEALONG_URL:-} "$REPO/scripts/connect-agents" "${1:-}"
}

cmd_migrate() {
  [ -d /opt/ridealong ] || die "There's no older install in /opt/ridealong."
  have_docker
  echo "Removing the old install. Your Brave profile stays where it is."
  sudo "$REPO/scripts/remove-host-install"
  rm -f "$LINK"
  cmd_up "$@"
}

cmd_uninstall() {
  load
  have_docker
  [ -f "$CONFIG" ] || die "Ridealong isn't set up here."
  if [ -z "$SUFFIX" ]; then cmd_connect --remove; fi
  [ "${RIDEALONG_NETWORK:-}" = tailscale ] && { timeout 20 tailscale serve --https="${RIDEALONG_HTTPS_PORT:-6087}" off >/dev/null 2>&1 || true; }
  # A named instance's image is its own (ridealong-dev:NAME), so --rmi all is safe.
  compose down --rmi all
  if [ -z "$SUFFIX" ]; then rm -f "$LINK"; fi
  rm -f "$CONFIG"
  rmdir "$CONFIG_DIR" 2>/dev/null || true
  echo "Removed. Your Brave profile and shared files are still in ${RIDEALONG_PROFILE} and ${RIDEALONG_FILES}."
}

command=${1:-help}
[ $# -gt 0 ] && shift
case "$command" in
  up) cmd_up "$@" ;;
  down) load; have_docker; compose down ;;
  restart) load; have_docker; compose restart; wait_healthy ;;
  status) cmd_status ;;
  logs) load; have_docker; compose logs -f --tail 100 ;;
  update) cmd_update ;;
  connect) cmd_connect "$@" ;;
  mcp) cmd_mcp "$@" ;;
  migrate) cmd_migrate "$@" ;;
  uninstall) cmd_uninstall ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
