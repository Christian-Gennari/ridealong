#!/bin/bash
# Runs before every Brave start: waits for the window manager so
# --start-maximized works, and clears what a hard kill leaves behind.
PROFILE=$HOME/.ridealong-browser
for _ in $(seq 100); do pgrep -u "$(id -un)" -x xfwm4 >/dev/null && break; sleep 0.2; done
# systemd has already killed the whole cgroup, so any lock here is stale.
rm -f "$PROFILE"/SingletonLock "$PROFILE"/SingletonSocket "$PROFILE"/SingletonCookie
mkdir -p "$PROFILE/Default"
python3 - "$PROFILE" <<'PY2'
import json, os, sys
profile_dir = sys.argv[1]

def edit(path, change):
    # Never block Brave over this; the worst case is a notice.
    try:
        try:
            with open(path) as f:
                data = json.load(f)
        except FileNotFoundError:
            data = {}
        change(data)
        with open(path + ".ridealong-tmp", "w") as f:
            json.dump(data, f)
        os.replace(path + ".ridealong-tmp", path)
    except Exception as e:
        print(f"ridealong-prestart: {e}", file=sys.stderr)

def clean_exit(prefs):
    profile = prefs.setdefault("profile", {})
    profile["exit_type"] = "Normal"
    profile["exited_cleanly"] = True

def no_prompts(state):
    brave = state.setdefault("brave", {})
    p3a = brave.setdefault("p3a", {})
    p3a["enabled"] = False
    p3a["notice_acknowledged"] = True
    # Otherwise a crash leaves a "quit unexpectedly" dialog with nobody there to answer it.
    brave["dont_ask_for_crash_reporting"] = True

if os.path.exists(os.path.join(profile_dir, "Default", "Preferences")):
    edit(os.path.join(profile_dir, "Default", "Preferences"), clean_exit)
edit(os.path.join(profile_dir, "Local State"), no_prompts)
PY2
exit 0
