#!/bin/bash
# The Ridealong MCP server, on stdio. Point any MCP client at this command.
#   ridealong-mcp [--agent NAME]
APP=/opt/ridealong
. "$APP/config.env"
export PATH=$APP/node/bin:/usr/local/bin:/usr/bin:/bin
export RIDEALONG_VIEWER=http://127.0.0.1:$VIEWER_PORT VIEWER_TOKEN
OUT=$HOME/.cache/playwright-mcp
mkdir -p -m 700 "$OUT"
exec node "$APP/mcp/ridealong-mcp.mjs" "$@" -- \
  npx -y @playwright/mcp@latest --cdp-endpoint http://127.0.0.1:9222 --output-dir "$OUT"
