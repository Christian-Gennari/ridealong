#!/usr/bin/env bash
# Registers Ridealong with the MCP clients it finds. `ridealong up` runs this the
# first time, and `ridealong connect` runs it after you install another one.
#   connect-agents [--remove]
set -euo pipefail
REPO=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
BIN=$HOME/.local/bin/ridealong
PATH=$HOME/.local/bin:$PATH

if [ "${1:-}" = --remove ]; then
  command -v claude >/dev/null && claude mcp remove ridealong --scope user >/dev/null 2>&1 || true
  command -v codex >/dev/null && codex mcp remove ridealong >/dev/null 2>&1 || true
  command -v gemini >/dev/null && gemini mcp remove --scope user ridealong >/dev/null 2>&1 || true
  command -v agy >/dev/null && agy mcp remove ridealong >/dev/null 2>&1 || true
  python3 - "$HOME/.claude/CLAUDE.md" "$HOME/.hermes/config.yaml" <<'PY'
import os, re, sys
claude, hermes = sys.argv[1:]
if os.path.exists(claude):
    text = open(claude).read()
    open(claude, "w").write(re.sub(r"\n*<!-- ridealong -->.*?<!-- /ridealong -->\n?", "\n", text, flags=re.S))
if os.path.exists(hermes):
    text = open(hermes).read()
    open(hermes, "w").write(re.sub(r"^  ridealong:\n(?:^(?:    .*|)\n)*", "", text, flags=re.M))
PY
  exit 0
fi

if command -v claude >/dev/null; then
  claude mcp remove playwright --scope user >/dev/null 2>&1 || true
  claude mcp remove ridealong --scope user >/dev/null 2>&1 || true
  claude mcp add ridealong --scope user -- "$BIN" mcp --agent Claude
  echo "Claude Code: registered"

  # Tell future sessions how to use the browser. Replaces our block on re-runs.
  mkdir -p "$HOME/.claude"
  python3 - "$HOME/.claude/CLAUDE.md" "$REPO/docs/agent-instructions.md" "${RIDEALONG_URL:-the viewer}" <<'PY'
import re, sys
path, source, url = sys.argv[1:]
start, end = "<!-- ridealong -->", "<!-- /ridealong -->"
body = open(source).read().replace("@VIEWER_URL@", url).strip()
block = f"{start}\n{body}\n{end}\n"
try:
    text = open(path).read()
except FileNotFoundError:
    text = ""
text = re.sub(r"<!-- agent-browser -->.*?<!-- /agent-browser -->\n?", "", text, flags=re.S)
pattern = re.compile(re.escape(start) + r".*?" + re.escape(end) + r"\n?", re.S)
if pattern.search(text):
    text = pattern.sub(block, text)
else:
    text = (text.rstrip() + "\n\n" if text.strip() else "") + block
open(path, "w").write(text)
PY
fi

if command -v codex >/dev/null; then
  codex mcp remove ridealong >/dev/null 2>&1 || true
  codex mcp add ridealong -- "$BIN" mcp --agent Codex
  # Codex gives up on a tool after 60 seconds, and a handover can wait 10 minutes.
  # `codex exec` has no one to approve a tool call, so it needs approve mode too.
  python3 - "$HOME/.codex/config.toml" <<'PY'
import re, sys
path = sys.argv[1]
s = open(path).read()
s = re.sub(r"^(\[mcp_servers\.ridealong\]\n)", r'\1tool_timeout_sec = 660\ndefault_tools_approval_mode = "approve"\n', s, count=1, flags=re.M)
open(path, "w").write(s)
PY
  echo "Codex: registered"
fi

if command -v gemini >/dev/null; then
  gemini mcp remove --scope user ridealong >/dev/null 2>&1 || true
  # A CLI that can't start must not stop the clients after it.
  if gemini mcp add --scope user ridealong "$BIN" mcp --agent Gemini >/dev/null 2>&1; then
    echo "Gemini CLI: registered"
  else
    echo "Gemini CLI: skipped, it failed to run. Fix it, then re-run this script."
  fi
fi

# Antigravity CLI, which replaces Gemini CLI.
if command -v agy >/dev/null; then
  agy mcp remove ridealong >/dev/null 2>&1 || true
  if agy mcp add ridealong "$BIN" mcp --agent Antigravity >/dev/null 2>&1; then
    echo "Antigravity CLI: registered"
  else
    echo "Antigravity CLI: skipped, it failed to run. Fix it, then run: ridealong connect"
  fi
fi

CONFIG=$HOME/.hermes/config.yaml
if [ -f "$CONFIG" ]; then
  cp "$CONFIG" "$CONFIG.bak-ridealong"
  python3 - "$CONFIG" "$BIN" <<'PY'
import re, sys
path, binary = sys.argv[1:]
block = f"""  ridealong:
    command: {binary}
    args:
      - mcp
      - --agent
      - Hermes
    timeout: 660
"""
s = open(path).read()
s = re.sub(r"^  (playwright|ridealong):\n(?:^(?:    .*|)\n)*", "", s, flags=re.M)
if re.search(r"^mcp_servers:\n", s, re.M):
    s = re.sub(r"^mcp_servers:\n", "mcp_servers:\n" + block, s, count=1, flags=re.M)
else:
    s = s.rstrip() + "\nmcp_servers:\n" + block
open(path, "w").write(s)
PY
  echo "Hermes: registered. Send /reload-mcp in Hermes, or restart its gateway."
fi
